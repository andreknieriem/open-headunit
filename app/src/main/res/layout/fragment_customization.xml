<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/customization_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/customization_title"
        app:navigationIcon="@drawable/ic_arrow_back_white"
        app:titleTextColor="?android:attr/textColorPrimary"
        app:navigationIconTint="?android:attr/textColorPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Live Background Preview Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_background_image"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_background_image_description"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <FrameLayout
                android:id="@+id/bg_preview_container"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_setting_single"
                android:clipToOutline="true"
                android:padding="4dp">

                <!-- Default bg XML gradient preview when no custom image is set -->
                <View
                    android:id="@+id/bg_default_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg" />

                <!-- Custom ImageView when an image file is selected -->
                <ImageView
                    android:id="@+id/bg_custom_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="@string/home_background_default"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_image"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_choose_image"
                    android:textColor="@color/btn_save_text"
                    app:backgroundTint="@color/btn_save_background"
                    app:icon="@drawable/ic_launch_white"
                    app:iconTint="@color/btn_save_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_bg"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_reset_default"
                    android:textColor="?android:attr/textColorPrimary" />

            </LinearLayout>

            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <!-- Button Colors Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_button_colors"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_button_colors_description"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Live Button Preview Card -->
            <LinearLayout
                android:id="@+id/preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_setting_single"
                android:padding="16dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preview_btn_self_mode"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="8dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/gradient_blue"
                    app:icon="@drawable/ic_launch_white"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconSize="28dp"
                    app:iconPadding="0dp"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preview_btn_usb"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="8dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/gradient_orange"
                    app:icon="@drawable/ic_usb_white"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconSize="28dp"
                    app:iconPadding="0dp"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preview_btn_wifi"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="8dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/gradient_purple"
                    app:icon="@drawable/ic_network_wifi_white"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconSize="28dp"
                    app:iconPadding="0dp"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preview_btn_settings"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="8dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/gradient_darkblue"
                    app:icon="@drawable/ic_settings_white"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconSize="28dp"
                    app:iconPadding="0dp"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <!-- Button Color Pickers List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_setting_single">

                <!-- Self Mode Button Color Row -->
                <LinearLayout
                    android:id="@+id/row_color_self_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/indicator_self_mode"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/gradient_blue"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_color_self_mode"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?android:attr/textColorSecondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <!-- USB Button Color Row -->
                <LinearLayout
                    android:id="@+id/row_color_usb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/indicator_usb"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/gradient_orange"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_color_usb"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?android:attr/textColorSecondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <!-- WiFi Button Color Row -->
                <LinearLayout
                    android:id="@+id/row_color_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/indicator_wifi"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/gradient_purple"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_color_wifi"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?android:attr/textColorSecondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <!-- Settings Button Color Row -->
                <LinearLayout
                    android:id="@+id/row_color_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/indicator_settings"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/gradient_darkblue"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_color_settings"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?android:attr/textColorSecondary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Reset All Colors Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_colors"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_reset_colors"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <!-- Button Size Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_button_scale"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_button_scale_description"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Slider Container Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_single"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_button_scale"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_button_scale_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_button_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="60"
                    android:valueTo="120"
                    android:stepSize="5"
                    android:value="100" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_scale"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_reset_scale"
                android:textColor="?android:attr/textColorPrimary" />

        </LinearLayout>

    </ScrollView>

    </LinearLayout>

    <!-- Samsung-style Fullscreen Live Home Screen Preview Overlay -->
    <FrameLayout
        android:id="@+id/overlay_home_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="24dp">

        <!-- Inflated Home Screen Layout Container -->
        <FrameLayout
            android:id="@+id/overlay_home_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Subtle Dimming View -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#20000000"
            android:clickable="false"
            android:focusable="false" />

        <!-- Floating Bottom Slider Control Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_setting_single"
            android:padding="16dp"
            android:layout_margin="16dp"
            android:elevation="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_button_scale"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_overlay_scale_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#2CC6F2"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_overlay_button_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="60"
                android:valueTo="120"
                android:stepSize="5"
                android:value="100" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
