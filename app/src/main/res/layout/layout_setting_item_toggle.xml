<?xml version="1.0" encoding="utf-8"?>
<!-- An on/off setting. SwitchCompat rather than the platform Switch so it looks the same on
     every Android version; its Material 3 track and thumb are built in code (SettingsDrawables). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_padding_start"
    android:paddingLeft="@dimen/settings_row_padding_start"
    android:paddingTop="@dimen/settings_row_padding_vertical"
    android:paddingEnd="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="@dimen/settings_row_padding_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/settingsOnSurface"
            android:textSize="@dimen/settings_row_title_size"
            tools:text="Audio Sink" />

        <TextView
            android:id="@+id/settingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="@integer/settings_description_max_lines"
            android:textColor="?attr/settingsOnSurfaceVariant"
            android:textSize="@dimen/settings_row_description_size"
            tools:text="If disabled, the headunit will not receive audio." />

    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/settingSwitch"
        style="@style/Widget.AppCompat.CompoundButton.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:background="@null" />

</LinearLayout>
