<?xml version="1.0" encoding="utf-8"?>
<!--
    The main button: the connection the user uses, and its state. HomeUiHelper paints it.
    A FrameLayout, so the date, the time and the speed can sit in the empty top corner without
    taking height from the content. That height is what the widget row under the favorite apps
    needs on a short screen, and giving it to a line of text instead would push the main button's
    action off the card.
    Focusable so a D-pad reaches its long press, which opens the page menu, the same as a finger.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_primary_card"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/home_primary_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/home_card_padding_h"
        android:paddingRight="@dimen/home_card_padding_h"
        android:paddingTop="@dimen/home_card_padding_v"
        android:paddingBottom="@dimen/home_card_padding_v">

        <LinearLayout
            android:id="@+id/home_primary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/home_primary_icon_tile"
                android:layout_width="@dimen/home_card_icon_tile"
                android:layout_height="@dimen/home_card_icon_tile">
                <ImageView
                    android:id="@+id/home_primary_icon"
                    android:layout_width="@dimen/home_card_icon"
                    android:layout_height="@dimen/home_card_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_usb_white" />
            </FrameLayout>

            <!-- Headunit Server on the phone's hotspot only: the WiFi network this unit is on, its
                 band and signal, or why there is none. Information only. It takes
                 three quarters of the row's free width and the spacer after it the rest, so it never
                 reaches the countdown or the date and time in the far corner. A name too long for
                 it steps down a size, then ends in an ellipsis. -->
            <LinearLayout
                android:id="@+id/home_wifi_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginStart="@dimen/home_wifi_status_gap"
                android:layout_marginLeft="@dimen/home_wifi_status_gap"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/home_wifi_warning"
                        android:layout_width="@dimen/home_wifi_dot"
                        android:layout_height="@dimen/home_wifi_dot"
                        android:layout_marginEnd="@dimen/home_wifi_meta_gap"
                        android:layout_marginRight="@dimen/home_wifi_meta_gap"
                        android:importantForAccessibility="no"
                        android:src="@drawable/home_wifi_warning_dot"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/home_wifi_name"
                        style="@style/HomeCardText"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="@dimen/home_wifi_name_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/home_wifi_band"
                        style="@style/HomeCardText"
                        android:layout_marginEnd="@dimen/home_wifi_meta_gap"
                        android:layout_marginRight="@dimen/home_wifi_meta_gap"
                        android:paddingLeft="@dimen/home_wifi_chip_padding_h"
                        android:paddingRight="@dimen/home_wifi_chip_padding_h"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textSize="@dimen/home_card_kicker"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/home_wifi_bars"
                        android:layout_width="@dimen/home_wifi_bars_width"
                        android:layout_height="@dimen/home_wifi_bars_height"
                        android:layout_marginEnd="@dimen/home_wifi_meta_gap"
                        android:layout_marginRight="@dimen/home_wifi_meta_gap"
                        android:importantForAccessibility="no"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_wifi_bars_0" />

                    <TextView
                        android:id="@+id/home_wifi_meta"
                        style="@style/HomeCardText"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="@dimen/home_card_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gives way to the WiFi line on a card too narrow for both (HomeUiHelper.fitCardWidth). -->
            <View
                android:id="@+id/home_primary_header_spacer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/home_countdown"
                android:layout_width="@dimen/home_countdown_size"
                android:layout_height="@dimen/home_countdown_size"
                android:background="@drawable/home_countdown_ring"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/home_countdown_text"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/home_primary_kicker"
            style="@style/HomeCardText"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textSize="@dimen/home_card_kicker"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_primary_title"
            style="@style/HomeCardText"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:textSize="@dimen/home_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_primary_subtitle"
            style="@style/HomeCardText"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:textSize="@dimen/home_card_subtitle" />

        <!-- While a connection comes up: the WiFi Direct group under the step, and how far along
             the steps are. They took the status pill's place, which floated over the home. -->
        <TextView
            android:id="@+id/home_primary_detail"
            style="@style/HomeCardText"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/home_card_subtitle"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_primary_progress"
            android:layout_width="@dimen/home_cta_min_width"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:importantForAccessibility="no"
            android:visibility="gone">

            <!-- A FrameLayout clips its children, so the shine sweeping across it stays inside the
                 part already done. -->
            <FrameLayout
                android:id="@+id/home_primary_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/home_primary_progress_shine"
                    android:layout_width="@dimen/home_progress_shine_width"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <View
                android:id="@+id/home_primary_progress_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/home_primary_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:divider="@drawable/home_gap"
            android:showDividers="middle">

            <!-- Weighted in a wrap_content row: it keeps its size while both fit and gives up width,
                 not Cancel, when they do not (portrait). Two lines because on a narrow portrait phone
                 the label would otherwise end as "Connect over ...". -->
            <TextView
                android:id="@+id/home_primary_action"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_cta_height"
                android:layout_weight="1"
                tools:ignore="InefficientWeight"
                android:minWidth="@dimen/home_cta_min_width"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:textSize="@dimen/home_cta_text" />

            <TextView
                android:id="@+id/home_primary_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_secondary_cta_height"
                android:layout_gravity="center_vertical"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:gravity="center"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/cancel"
                android:textColor="@android:color/white"
                android:textSize="@dimen/home_secondary_cta_text"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Date, time and GPS speed, when the driver asked for them. HomeUiHelper.applyInfoBlock fills
         it in. It floats in the empty top corner, which is why it takes no height from the card,
         and it steps aside while the countdown runs, which is the one moment that corner is used. -->
    <LinearLayout
        android:id="@+id/home_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="@dimen/home_card_padding_v"
        android:layout_marginRight="@dimen/home_card_padding_h"
        android:orientation="vertical"
        android:gravity="right"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/home_info_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/home_info_time"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/home_info_speed_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/home_info_gap_wide"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:visibility="gone">

                <TextView
                    android:id="@+id/home_info_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/home_info_speed"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_info_speed_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:maxLines="1"
                    android:text="@string/home_speed_unit"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/home_info_date" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/home_info_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/home_info_date"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
