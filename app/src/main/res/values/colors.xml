    <color name="warning_banner_stroke">#66F57C00</color>
    <color name="warning_banner_icon">#F57C00</color>


    <!-- Material 3 color roles: the blue scheme Material Theme Builder generates (source #415F91).
         Selections use the secondary container, a muted slate blue, as Material does. The
         settings screen reads them through the settings* theme attributes (see attrs.xml), so
         extreme dark can swap them. -->
    <color name="md_surface">#F9F9FF</color>
    <color name="md_surface_container">#EDEDF4</color>
    <color name="md_surface_container_highest">#E2E2E9</color>
    <color name="md_surface_container_high">#E7E8EE</color>
    <color name="md_on_surface">#191C20</color>
    <color name="md_on_surface_variant">#44474E</color>
    <color name="md_outline">#74777F</color>
    <color name="md_outline_variant">#C4C6D0</color>
    <color name="md_primary">#415F91</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_secondary_container">#DAE2F9</color>
    <color name="md_on_secondary_container">#131C2B</color>

    <!-- Extreme dark: every surface is black and only faint outlines separate groups. -->
    <color name="md_extreme_container_highest">#0D0D0D</color>
    <color name="md_extreme_on_surface">#B8B8B8</color>
    <color name="md_extreme_on_surface_variant">#7A7A7A</color>
