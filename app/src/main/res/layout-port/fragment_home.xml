<?xml version="1.0" encoding="utf-8"?>
<!--
    Portrait: the main button on top, the favorite apps under it and the driver bar as a row along
    the bottom, where the hand reaches first on a tall screen. Its tiles share the width, so a
    narrow phone never cuts one off. The bar starts from the driver's side; HomeUiHelper.applyDriverSide
    reverses it, and the favorites, for a right-hand drive car.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/home_gap"
    android:divider="@drawable/home_gap"
    android:showDividers="middle">

    <include layout="@layout/view_home_primary_card" />

    <include layout="@layout/view_home_favorites" />

    <LinearLayout
        android:id="@+id/home_driver_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/home_gap"
        android:background="@drawable/home_panel_bg"
        android:divider="@drawable/home_gap"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/usb_button"
            style="@style/HomeTile"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_usb_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/usb" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wifi_button"
            style="@style/HomeTile"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_network_wifi_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/wifi" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/self_mode_button"
            style="@style/HomeTile"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_launch_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/self_mode" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_button"
            style="@style/HomeTile"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_settings_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exit_button"
            style="@style/HomeTile"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_power_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/exit" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
