<?xml version="1.0" encoding="utf-8"?>
<!-- The codes that open hidden menus: the one that matches this unit, a search, the list that
     ships with the app, and a QR code to the full list for units without internet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adbGuideCodesPane"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/adbGuideCodesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingLeft="4dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="12dp"
        android:text="@string/adb_guide_codes"
        android:textColor="?attr/settingsPrimary"
        android:textSize="@dimen/settings_row_title_size"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/adbGuideMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/adbGuideMatchLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_guide_for_this_unit"
                    android:textSize="@dimen/settings_row_description_size" />

                <TextView
                    android:id="@+id/adbGuideMatchBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingLeft="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:textSize="12sp"
                    tools:text="Tested" />

            </LinearLayout>

            <TextView
                android:id="@+id/adbGuideMatchUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/settingsOnSurface"
                android:textSize="@dimen/settings_row_title_size"
                tools:text="Reglink (CMZX65)" />

            <TextView
                android:id="@+id/adbGuideMatchOpens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/settingsOnSurfaceVariant"
                android:textSize="@dimen/settings_row_description_size"
                tools:text="Hidden menu with Developer and ADB over Wi-Fi" />

        </LinearLayout>

        <TextView
            android:id="@+id/adbGuideMatchCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            android:textColor="?attr/settingsOnSurface"
            android:textSize="@dimen/adb_guide_match_code_size"
            android:textStyle="bold"
            tools:text="9569" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/adbGuideSearchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingLeft="16dp"
        android:paddingEnd="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/adbGuideSearchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/adbGuideSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/adb_guide_search"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp"
            android:textColor="?attr/settingsOnSurface"
            android:textColorHint="?attr/settingsOnSurfaceVariant"
            android:textSize="@dimen/settings_row_title_size"
            tools:ignore="UnusedAttribute" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/adbGuideCodeList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/adbGuideNoResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.15"
        android:paddingStart="4dp"
        android:paddingLeft="4dp"
        android:paddingTop="16dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="16dp"
        android:textColor="?attr/settingsOnSurfaceVariant"
        android:textSize="@dimen/settings_row_title_size"
        android:visibility="gone" />

    <View
        android:id="@+id/adbGuideFooterLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <FrameLayout
            android:id="@+id/adbGuideQrBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:padding="6dp">

            <ImageView
                android:layout_width="@dimen/adb_guide_qr_size"
                android:layout_height="@dimen/adb_guide_qr_size"
                android:contentDescription="@string/adb_guide_qr_description"
                app:srcCompat="@drawable/ic_adb_guide_qr" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_guide_full_list"
                android:textColor="?attr/settingsOnSurface"
                android:textSize="@dimen/settings_row_title_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/adb_guide_full_list_body"
                android:textColor="?attr/settingsOnSurfaceVariant"
                android:textSize="@dimen/settings_row_description_size" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
