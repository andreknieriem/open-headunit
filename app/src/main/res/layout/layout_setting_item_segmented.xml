<?xml version="1.0" encoding="utf-8"?>
<!-- A choice of up to three options as a Material 3 segmented button. Colors and corner shapes
     are set in code (SettingsAdapter.SegmentedButtonViewHolder). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_row_padding_start"
    android:paddingLeft="@dimen/settings_row_padding_start"
    android:paddingTop="@dimen/settings_row_padding_vertical"
    android:paddingEnd="@dimen/settings_row_padding_start"
    android:paddingRight="@dimen/settings_row_padding_start"
    android:paddingBottom="@dimen/settings_row_padding_vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/settingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/settingsOnSurface"
            android:textSize="@dimen/settings_row_title_size"
            tools:text="Wireless Mode"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/settingHelp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/settingHelp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/settingName"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption1"
            style="@style/SettingsSegment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Wireless Helper" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption2"
            style="@style/SettingsSegment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-1dp"
            android:layout_marginLeft="-1dp"
            android:layout_weight="1"
            tools:text="Native" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption3"
            style="@style/SettingsSegment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-1dp"
            android:layout_marginLeft="-1dp"
            android:layout_weight="1"
            tools:text="Headunit Server" />

    </LinearLayout>

</LinearLayout>
