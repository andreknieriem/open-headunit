<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:dialogTheme">@style/DarkAlertDialog</item>
        <item name="android:alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/DarkAlertDialog</item>
        <item name="settingsSurface">@color/md_surface</item>
        <item name="settingsContainer">@color/md_surface_container</item>
        <item name="settingsContainerHigh">@color/md_surface_container_high</item>
        <item name="settingsContainerHighest">@color/md_surface_container_highest</item>
        <item name="settingsOnSurface">@color/md_on_surface</item>
        <item name="settingsOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="settingsOutline">@color/md_outline</item>
        <item name="settingsOutlineVariant">@color/md_outline_variant</item>
        <item name="settingsPrimary">@color/md_primary</item>
        <item name="settingsOnPrimary">@color/md_on_primary</item>
        <item name="settingsSecondaryContainer">@color/md_secondary_container</item>
        <item name="settingsOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="settingsOutlinedGroups">false</item>
        <item name="settingsFilledIcons">true</item>
    </style>

    <style name="AppTheme.Translucent" parent="android:Theme.Translucent.NoTitleBar" />

    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

    <style name="SplashTheme.Fullscreen" parent="SplashTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="DarkAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:textColorPrimary">@color/adaptive_text_color</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton.Negative</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.App.Dialog.Rounded</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Dialog.Rounded</item>
    </style>

    <style name="DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:backgroundTint">@color/brand_primary</item>
        <item name="android:background">@drawable/btn_primary</item>
    </style>

    <style name="DialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
    </style>
    <style name="DialogWindowTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SafetyDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeOverlay.ExtremeDark" parent="">
        <item name="colorSurface">@color/extreme_dark_background</item>
        <item name="android:colorBackground">@color/extreme_dark_background</item>
        <item name="android:windowBackground">@color/extreme_dark_background</item>
        <item name="settingsSurface">@color/extreme_dark_background</item>
        <item name="settingsContainer">@color/extreme_dark_background</item>
        <item name="settingsContainerHigh">@color/extreme_dark_background</item>
        <item name="settingsContainerHighest">@color/md_extreme_container_highest</item>
        <item name="settingsOnSurface">@color/md_extreme_on_surface</item>
        <item name="settingsOnSurfaceVariant">@color/md_extreme_on_surface_variant</item>
        <item name="settingsOutline">@color/md_extreme_outline</item>
        <item name="settingsOutlineVariant">@color/md_extreme_outline_variant</item>
        <item name="settingsPrimary">@color/md_extreme_primary</item>
        <item name="settingsOnPrimary">@color/extreme_dark_background</item>
        <item name="settingsSecondaryContainer">@color/md_extreme_secondary_container</item>
        <item name="settingsOnSecondaryContainer">@color/md_extreme_on_surface</item>
        <item name="settingsOutlinedGroups">true</item>
        <item name="settingsFilledIcons">false</item>
    </style>

    <style name="ThemeOverlay.GradientBackground" parent="">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
    </style>

    <!-- One option of a segmented setting. Colors and corners are set in code from the
         settings palette (SettingsAdapter.SegmentedButtonViewHolder). -->
    <style name="SettingsSegment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:checkable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">@dimen/settings_segment_min_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/settings_control_text_size</item>
    </style>

    <!-- Header controls of the settings screen (tabs, search, save). Colors set in code. -->
    <style name="SettingsTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:checkable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/settings_control_text_size</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">@dimen/settings_control_icon_size</item>
    </style>

    <style name="SettingsIconButton">
        <item name="android:layout_width">@dimen/settings_icon_button_size</item>
        <item name="android:layout_height">@dimen/settings_icon_button_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/settings_icon_button_padding</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Segmented Button Shapes -->
    <style name="ShapeAppearance.App.Button.Left" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Button.Middle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Button.Right" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.Dialog.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
