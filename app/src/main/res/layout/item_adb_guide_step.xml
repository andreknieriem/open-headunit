<?xml version="1.0" encoding="utf-8"?>
<!-- One step of the guide to turning on ADB: its number in a circle and what to do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/stepNumber"
        android:layout_width="@dimen/adb_guide_step_number"
        android:layout_height="@dimen/adb_guide_step_number"
        android:layout_marginEnd="14dp"
        android:layout_marginRight="14dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="@dimen/settings_control_text_size"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/stepText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:lineSpacingMultiplier="1.15"
        android:paddingTop="3dp"
        android:textColor="?attr/settingsOnSurface"
        android:textSize="@dimen/adb_guide_step_text_size"
        tools:text="Open the unit's Settings and go to About." />

</LinearLayout>
