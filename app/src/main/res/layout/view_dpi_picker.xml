<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.andrerinas.openheadunit.view.DpiPreviewView
        android:id="@+id/dpi_preview"
        android:layout_width="match_parent"
        android:layout_height="190dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/dpi_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:valueFrom="110"
        android:valueTo="640"
        android:stepSize="1"
        android:value="160" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dpi_input_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:hint="@string/dpi_input_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dpi_input"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="3" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/dpi_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dpi_tab_small"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="@string/onb_dpi_small"
            android:text="@string/dpi_size_s" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dpi_tab_medium"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="@string/onb_dpi_medium"
            android:text="@string/dpi_size_m" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dpi_tab_large"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="@string/onb_dpi_large"
            android:text="@string/dpi_size_l" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dpi_tab_huge"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="@string/onb_dpi_huge"
            android:text="@string/dpi_size_xl" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</merge>
