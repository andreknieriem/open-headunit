<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_row_padding_start"
    android:paddingLeft="@dimen/settings_row_padding_start"
    android:paddingTop="@dimen/settings_row_padding_vertical"
    android:paddingEnd="@dimen/settings_row_padding_start"
    android:paddingRight="@dimen/settings_row_padding_start"
    android:paddingBottom="@dimen/settings_row_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settingName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/settingsOnSurface"
            android:textSize="@dimen/settings_row_title_size"
            tools:text="WiFi wait timeout" />

        <TextView
            android:id="@+id/settingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            android:textColor="?attr/settingsOnSurfaceVariant"
            android:textSize="@dimen/settings_row_value_size"
            tools:text="10 s" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/settingSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="40dp" />

</LinearLayout>
