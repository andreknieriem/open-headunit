<?xml version="1.0" encoding="utf-8"?>
<!--
    Driver bar on the left, main button and favorite apps on the right. Written for a left-hand
    drive car; HomeUiHelper.applyDriverSide reverses the horizontal rows for a right-hand drive one,
    because setLayoutDirection does not exist on Android 4.1.
    Gaps are LinearLayout dividers rather than margins, so they survive that reversal.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="@dimen/home_gap"
    android:divider="@drawable/home_gap"
    android:showDividers="middle">

    <LinearLayout
        android:id="@+id/home_driver_bar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/home_gap"
        android:background="@drawable/home_panel_bg"
        android:divider="@drawable/home_gap"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/usb_button"
            style="@style/HomeTile">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_usb_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/usb" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wifi_button"
            style="@style/HomeTile">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_network_wifi_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/wifi" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/self_mode_button"
            style="@style/HomeTile">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_launch_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/self_mode" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_button"
            style="@style/HomeTile">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_settings_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:text="@string/settings" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/exit_button"
            style="@style/HomeTile"
            android:layout_height="@dimen/home_exit_height"
            android:orientation="horizontal">
            <ImageView
                style="@style/HomeTileIcon"
                app:srcCompat="@drawable/ic_power_white" />
            <TextView
                style="@style/HomeTileLabel"
                android:layout_marginTop="0dp"
                android:text="@string/exit" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:divider="@drawable/home_gap"
        android:showDividers="middle">

        <include layout="@layout/view_home_primary_card" />

        <include layout="@layout/view_home_favorites" />

    </LinearLayout>

</LinearLayout>
